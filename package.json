{
  "name": "debug-dataStructures-visualizer-extension",
  "displayName": "Debug Data Structures Visualizer",
  "description": "See your data structures while you debug: binary trees, linked lists, stacks, queues, heaps, hash tables, n-ary trees and tries, drawn live from Python and Java debug sessions.",
  "version": "2.0.0",
  "publisher": "MCCProgrammer",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "Education"
  ],
  "keywords": [
    "debug",
    "visualization",
    "data-structures",
    "binary-tree",
    "tree",
    "d3",
    "python",
    "java",
    "debugger",
    "linked-list",
    "stack",
    "queue",
    "heap",
    "hash-table",
    "trie",
    "algorithms",
    "students"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MCCProgrammer/debug-dataStructures-visualizer-extension"
  },
  "bugs": {
    "url": "https://github.com/MCCProgrammer/debug-dataStructures-visualizer-extension/issues"
  },
  "homepage": "https://github.com/MCCProgrammer/debug-dataStructures-visualizer-extension#readme",
  "sponsor": {
    "url": "https://ko-fi.com/mccprogrammer"
  },
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onDebug"
  ],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dataStructuresVisualizer.openVisualizer",
        "title": "Open Data Structure Visualizer",
        "icon": "$(graph)",
        "category": "Data Structures Visualizer"
      },
      {
        "command": "dataStructuresVisualizer.visualizeVariable",
        "title": "Visualize Data Structure",
        "icon": "$(graph)",
        "category": "Data Structures Visualizer"
      },
      {
        "command": "dataStructuresVisualizer.refreshVisualization",
        "title": "Refresh Visualization",
        "icon": "$(refresh)",
        "category": "Data Structures Visualizer"
      }
    ],
    "keybindings": [
      {
        "command": "dataStructuresVisualizer.openVisualizer",
        "key": "ctrl+k ctrl+v",
        "mac": "cmd+k cmd+v",
        "when": "inDebugMode"
      },
      {
        "command": "dataStructuresVisualizer.refreshVisualization",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeWebviewPanelId == 'dataStructuresVisualizer'"
      }
    ],
    "menus": {
      "debug/toolbar": [
        {
          "command": "dataStructuresVisualizer.openVisualizer",
          "when": "inDebugMode",
          "group": "visualization"
        }
      ],
      "debug/variables/context": [
        {
          "command": "dataStructuresVisualizer.visualizeVariable",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "dataStructuresVisualizer.openVisualizer",
          "when": "inDebugMode",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "dataStructuresVisualizer.openVisualizer",
          "when": "inDebugMode",
          "group": "debug"
        }
      ],
      "commandPalette": [
        {
          "command": "dataStructuresVisualizer.visualizeVariable",
          "when": "false"
        }
      ],
      "webview/title": [
        {
          "command": "dataStructuresVisualizer.refreshVisualization",
          "when": "webviewId == dataStructuresVisualizer",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Data Structures Visualizer",
      "properties": {
        "dataStructuresVisualizer.maxDepth": {
          "type": "number",
          "default": 20,
          "description": "Maximum depth to traverse when building tree structure",
          "minimum": 1,
          "maximum": 100
        },
        "dataStructuresVisualizer.showDebugControls": {
          "type": "boolean",
          "default": true,
          "description": "Show debug control buttons (Step Over, Step Into, etc.) in the visualization"
        },
        "dataStructuresVisualizer.treeOrientation": {
          "type": "string",
          "enum": [
            "horizontal",
            "vertical"
          ],
          "default": "horizontal",
          "description": "Orientation of the tree visualization. Horizontal: left to right. Vertical: top to bottom."
        },
        "dataStructuresVisualizer.autoRefreshInterval": {
          "type": "number",
          "default": 300,
          "description": "Delay in milliseconds before refreshing after debug actions (Step Over, Step Into, etc.) or debug state changes",
          "minimum": 0,
          "maximum": 2000
        }
      }
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/extensionTests.js",
    "pretest": "npm run compile-web",
    "vscode:prepublish": "npm run package-web",
    "compile-web": "npm run check-types && npm run lint && node esbuild.js",
    "watch-web": "npm-run-all -p watch-web:*",
    "watch-web:esbuild": "node esbuild.js --watch",
    "watch-web:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-web": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-web": "^0.0.74",
    "assert": "^2.1.0",
    "d3": "7.9.0",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "glob": "^11.0.3",
    "mocha": "^11.7.4",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  }
}
